rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Security Primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['ursula879518@gmail.com', '87informatica@gmail.com'] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'title', 'store', 'affiliateUrl']) &&
        data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() <= 300 &&
        data.store is string && data.store.size() <= 100 &&
        data.affiliateUrl is string && data.affiliateUrl.size() <= 2048 &&
        (!('order' in data) || data.order is number) &&
        (!('price' in data) || data.price is number || data.price is string) &&
        (!('originalPrice' in data) || data.originalPrice is number || data.originalPrice is string) &&
        (!('clicksCount' in data) || data.clicksCount is number) &&
        (!('realClicksCount' in data) || data.realClicksCount is number) &&
        (!('realViewsCount' in data) || data.realViewsCount is number) &&
        (!('isCollection' in data) || data.isCollection is bool) &&
        (!('collectionButtonText' in data) || (data.collectionButtonText is string && data.collectionButtonText.size() <= 200));
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['id', 'name']) &&
        data.id is string && data.id.size() <= 128 &&
        data.name is string && data.name.size() <= 100;
    }

    function isValidBanner(data) {
      return data.keys().hasAll(['id', 'title', 'imageUrl']) &&
        data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() <= 200 &&
        data.imageUrl is string && data.imageUrl.size() <= 2048;
    }

    function isValidSiteConfig(data) {
      return (!('whatsappNumber' in data) || (data.whatsappNumber is string && data.whatsappNumber.size() <= 50)) &&
        (!('siteName' in data) || (data.siteName is string && data.siteName.size() <= 100));
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(['uid', 'email']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 200;
    }

    // Products Collection: Public read catalog, validated product management, public click tracking
    match /products/{productId} {
      allow read: if true;
      allow create: if isValidId(productId) && isValidProduct(incoming());
      allow delete: if isValidId(productId);
      allow update: if isValidId(productId) && (
        isValidProduct(incoming()) ||
        (incoming().diff(existing()).affectedKeys().hasOnly(['clicksCount', 'realClicksCount', 'realViewsCount']))
      );
    }

    // Categories Collection: Public read, validated category management
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isValidId(categoryId) && isValidCategory(incoming());
      allow delete: if isValidId(categoryId);
    }

    // Banners Collection: Public read, validated banner management
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update: if isValidId(bannerId) && isValidBanner(incoming());
      allow delete: if isValidId(bannerId);
    }

    // Site Settings:
    match /settings/siteConfig {
      allow read: if true;
      allow write: if isValidSiteConfig(incoming());
    }

    match /settings/adminAuth {
      allow read, write: if true;
    }

    match /settings/{otherSetting} {
      allow read, write: if true;
    }

    // Admins registry: Admins or self can read/write
    match /admins/{adminId} {
      allow read: if true;
      allow write: if isValidId(adminId) && isValidAdmin(incoming());
    }
  }
}
